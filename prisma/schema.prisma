generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  gender       String
  category     String
  subcategory  String
  price        Decimal   @db.Decimal(10, 2)
  salePrice    Decimal?  @db.Decimal(10, 2)
  onSale       Boolean   @default(false)
  isNew        Boolean   @default(false)
  isBestSeller Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  rating       Float     @default(5.0)
  reviewCount  Int       @default(0)
  description  String    @default("")
  fabricCare   String    @default("Premium material blend. Hand wash or dry clean recommended.")
  images       String    @default("[]")
  sizes        String    @default("[]")
  colors       String    @default("[]")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  variants     Variant[]

  @@index([gender, category, isActive])
  @@index([isFeatured, isNew])
}

model Variant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  barcode       String?
  size          String
  color         String
  price         Decimal  @db.Decimal(10, 2)
  salePrice     Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(10)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                     String               @id @default(cuid())
  orderNumber            String               @unique
  customerName           String
  customerEmail          String               @default("")
  customerPhone          String
  customerCounty         String
  customerTownCity       String
  customerAddress        String
  customerNotes          String               @default("")
  items                  String
  subtotal               Decimal              @db.Decimal(10, 2)
  discount               Decimal              @default(0) @db.Decimal(10, 2)
  couponCode             String?
  deliveryFee            Decimal              @default(350) @db.Decimal(10, 2)
  total                  Decimal              @db.Decimal(10, 2)
  currency               String               @default("KES")
  paymentMethod          String
  paymentStatus          String               @default("PENDING")
  fulfillmentStatus      String               @default("PENDING")
  mpesaPhone             String?
  mpesaReceipt           String?              @unique
  createdAt              DateTime             @default(now())
  trackingTokenHash      String               @unique
  mpesaIdempotencyKey    String?              @unique
  mpesaCheckoutRequestId String?              @unique
  mpesaInitiatedAt       DateTime?
  mpesaMerchantRequestId String?              @unique
  // Payment expiry — if not paid by this time, stock reservation is released
  paymentExpiresAt       DateTime?
  paymentNotifications   PaymentNotification?
}

model PaymentNotification {
  id               String    @id @default(cuid())
  // Ownership: exactly one of orderId or posSaleId must be non-null.
  // Enforced at application layer in paymentNotifications.ts.
  orderId          String?   @unique
  customerName     String
  customerPhone    String
  amount           Decimal   @db.Decimal(10, 2)
  currency         String    @default("KES")
  paymentMethod    String    @default("MPESA")
  mpesaReceipt     String?
  createdAt        DateTime  @default(now())
  acknowledgedAt   DateTime?
  paymentReference String    @unique
  posSaleId        String?   @unique
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  posSale          PosSale?  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([acknowledgedAt, createdAt])
}

// Unmatched incoming payments — C2B Till payments that could not be
// automatically correlated to a pending order or POS sale. Owner must
// review and manually assign each one.
model UnmatchedPayment {
  id             String   @id @default(cuid())
  mpesaReceipt   String   @unique
  amount         Decimal  @db.Decimal(10, 2)
  phone          String
  payerName      String?
  rawPayload     String   // full Safaricom callback JSON for audit
  receivedAt     DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  status         String   @default("UNMATCHED") // UNMATCHED | ASSIGNED | IGNORED

  @@index([status, receivedAt])
}

// ── Website Checkout Session ───────────────────────────────────────────────
// Created BEFORE any order. Holds customer intent and cart while waiting
// for Safaricom C2B payment. Order and stock deduction happen only inside
// the C2B callback transaction — never before payment confirmation.
model CheckoutSession {
  id              String    @id @default(cuid())
  sessionRef      String    @unique  // customer-facing reference e.g. GC-PAY-XXXXX
  customerName    String
  customerEmail   String    @default("")
  customerPhone   String
  customerCounty  String
  customerTownCity String
  customerAddress  String
  customerNotes   String    @default("")
  itemsJson       String    // JSON snapshot of cart items + prices at session creation
  subtotal        Decimal   @db.Decimal(10, 2)
  discount        Decimal   @default(0) @db.Decimal(10, 2)
  couponCode      String?
  deliveryFee     Decimal   @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  currency        String    @default("KES")
  paymentMethod   String    @default("MPESA")
  status          String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | PAID | EXPIRED | FAILED
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  mpesaReceipt    String?   @unique
  orderId         String?   @unique  // set after Order is created on payment confirmation

  @@index([status, expiresAt])
  @@index([sessionRef])
}

// ── POS Sale Payment Ledger ───────────────────────────────────────────────
// Records each individual payment component for a POS sale.
// Supports mixed payments (e.g. M-PESA + Cash) and partial payments.
model SalePayment {
  id            String   @id @default(cuid())
  posSaleId     String
  posSale       PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  method        String   // MPESA | CASH
  amount        Decimal  @db.Decimal(10, 2)
  mpesaReceipt  String?  @unique
  status        String   @default("CONFIRMED") // CONFIRMED | PENDING | FAILED
  confirmedAt   DateTime @default(now())

  @@index([posSaleId])
}

model Coupon {
  code           String   @id
  discountType   String
  discountValue  Decimal  @db.Decimal(10, 2)
  minOrderAmount Decimal  @default(0) @db.Decimal(10, 2)
  expiryDate     String
  usageLimit     Int      @default(100)
  usageCount     Int      @default(0)
  isActive       Boolean  @default(true)
}

model Admin {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             String            @default("OWNER")
  pinCode          String            @default("")
  createdAt        DateTime          @default(now())
  posLoginRequests PosLoginRequest[]
}

model StoreSettings {
  id                       String   @id @default("default")
  storeName                String   @default("Gem & Crystal Fashion Hub")
  tagline                  String   @default("BE BOLD. BE BRIGHT. BE YOU.")
  location                 String   @default("Roysambu, Nairobi, Kenya")
  phone                    String   @default("+254 718 796 296")
  whatsappNumber           String   @default("254718796296")
  deliveryFeeDisclaimer    String   @default("Delivery fee is paid separately by the customer and is not included in the product order total unless otherwise stated by the shop.")
  // Delivery pricing — single source of truth used by checkout, AI, and frontend
  deliveryFeeKes           Int      @default(350)
  freeDeliveryThresholdKes Int      @default(10000)
  aiChatEnabled            Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model PosLoginRequest {
  id            String   @id @default(cuid())
  cashierId     String
  cashierName   String
  deviceId      String
  location      String
  biometricId   String?
  pollTokenHash String   @unique
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  cashier       Admin    @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([cashierId, createdAt])
}

model PosSession {
  id               String    @id @default(cuid())
  requestId        String    @unique
  cashierId        String
  cashierName      String
  approvedBy       String
  sessionTokenHash String    @unique
  status           String    @default("ACTIVE")
  startTime        DateTime  @default(now())
  expiresAt        DateTime
  endTime          DateTime?
}

model PosSale {
  id                     String               @id @default(cuid())
  receiptNumber          String               @unique
  // Session linkage — ties every sale to the exact cashier session that created it
  cashierId              String?
  cashierName            String
  sessionId              String?
  deviceId               String?
  customerName           String               @default("Walk-in Customer")
  customerPhone          String?
  mpesaReceipt           String?              @unique
  items                  String
  subtotal               Decimal              @db.Decimal(10, 2)
  discount               Decimal              @default(0) @db.Decimal(10, 2)
  total                  Decimal              @db.Decimal(10, 2)
  paymentMethod          String
  cashReceived           Decimal?             @db.Decimal(10, 2)
  changeGiven            Decimal?             @db.Decimal(10, 2)
  createdAt              DateTime             @default(now())
  // Payment lifecycle
  mpesaIdempotencyKey    String?              @unique
  mpesaCheckoutRequestId String?              @unique
  mpesaInitiatedAt       DateTime?
  mpesaMerchantRequestId String?              @unique
  paymentStatus          String               @default("PAID")
  // Payment expiry — if not paid by this time, stock reservation is released
  paymentExpiresAt       DateTime?
  // Sale completion — payment verified ≠ sale completed (cashier must confirm)
  // Stock is deducted atomically INSIDE the complete-sale transaction, NOT at checkout.
  saleStatus             String               @default("OPEN")   // OPEN | COMPLETED | CANCELLED | EXPIRED
  completedAt            DateTime?
  payments               SalePayment[]        // individual payment components (M-PESA, cash)
  paymentNotifications   PaymentNotification?

  @@index([cashierId, createdAt])
  @@index([sessionId, paymentStatus])
  @@index([saleStatus, createdAt])
}

model HardwareConfig {
  id                String  @id @default("pos-01")
  tabletName        String  @default("Gem & Crystal POS Tablet 01")
  tabletConnected   Boolean @default(false)
  barcodeScanner    Boolean @default(false)
  fingerprintReader Boolean @default(false)
  receiptPrinter    Boolean @default(false)
  cashDrawer        Boolean @default(false)
  status            String  @default("IDLE")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  variantId     String
  type          String
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String
  referenceType String?
  referenceId   String?
  actor         String   @default("System")
  createdAt     DateTime @default(now())

  @@index([variantId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  county    String?
  city      String?
  createdAt DateTime @default(now())
}
