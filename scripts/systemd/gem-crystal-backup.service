[Unit]
Description=Gem and Crystal PostgreSQL backup
OnFailure=gem-crystal-backup-failure.service

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/gem-crystal-api
ExecStart=/usr/bin/node %h/Desktop/gem-crystal-api/scripts/database-backup.mjs backup
UMask=0077
Nice=10
NoNewPrivileges=true
TimeoutStartSec=15min
