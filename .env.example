# Server
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gem_crystal"
JWT_SECRET="replace-with-a-long-random-secret"
POS_SESSION_SECRET="replace-with-a-different-long-random-secret"

# Allowed browser origins (required in production)
STOREFRONT_URL="https://shop.example.com"
ADMIN_URL="https://admin.example.com"
POS_URL="https://pos.example.com"

# ── M-PESA Integration ────────────────────────────────────────────────────
# Safaricom Daraja credentials (keep in deployment secret manager)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL for C2B callbacks: /api/orders/mpesa-c2b-callback
MPESA_CALLBACK_URL=https://api.example.com/api/orders/mpesa-c2b-callback
MPESA_CALLBACK_SECRET=
# The physical Till number customers pay to (Buy Goods / Lipa na M-PESA)
MPESA_TILL_NUMBER=

# ── AI Chat Assistant ──────────────────────────────────────────────────────
# Provider: openrouter (free) or openai (paid)
AI_PROVIDER=openrouter
# Get your free OpenRouter key at: https://openrouter.ai/keys
AI_API_KEY=
# Free models: minimax/minimax-m3:free  |  nousresearch/hermes-3-llama-3.1-405b:free  |  openrouter/free
# Paid models: openai/gpt-4o-mini  |  openai/gpt-4o
AI_MODEL=minimax/minimax-m3:free
# Max tokens the model may generate per response (keep low to control cost)
AI_MAX_TOKENS=500
